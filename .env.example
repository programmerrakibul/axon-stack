# Environment Variables Configuration
# ====================================
# Copy this file to .env.local and fill in your values.
# DO NOT commit .env.local to version control - it contains secrets!
# See .gitignore to ensure .env.local is ignored.

# ====================================
# DATABASE CONFIGURATION (REQUIRED)
# ====================================
# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_uri_string

# ====================================
# NEXTAUTH CONFIGURATION (REQUIRED)
# ====================================
# NextAuth Secret: Generate with: openssl rand -base64 32
# MUST be at least 32 characters for security
# Command to generate: 
#   On macOS/Linux: openssl rand -base64 32
#   On Windows (PowerShell): [Convert]::ToBase64String([byte[]]::new(32) | ForEach-Object { Get-Random -Max 256 })
NEXTAUTH_SECRET=your-secret-key-here-minimum-32-characters-required

# NextAuth URL: The canonical URL of your site
# Must match your deployment URL exactly
NEXTAUTH_URL=http://localhost:3000

# ====================================
# NODE ENVIRONMENT (Optional)
# ====================================
# Set to "production" for production deployments
# Defaults to "development" if not set
NODE_ENV=development

# ====================================
# IMPORTANT SECURITY NOTES
# ====================================
# ❌ DO NOT use NEXT_PUBLIC_ prefix for secrets
# Only environment variables prefixed with NEXT_PUBLIC_ are sent to the browser
# Keep all sensitive data (API keys, secrets, tokens) without the prefix

# ✅ Server-side only (not exposed to browser):
# - MONGODB_URI
# - NEXTAUTH_SECRET
# - NEXTAUTH_URL

# ❌ Never commit .env.local to git
# It is already in .gitignore for safety

# ✅ To generate a secure NEXTAUTH_SECRET:
# macOS/Linux:   openssl rand -base64 32
# Windows:       [Convert]::ToBase64String([byte[]]::new(32) | ForEach-Object { Get-Random -Max 256 })
# Or use: https://generate-secret.vercel.app/32

